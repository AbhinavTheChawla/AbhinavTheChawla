# Supabase Configuration
# Copy this file to .env and add your actual Supabase credentials
# You can find these in your Supabase project settings at:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
REACT_APP_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (safe to expose in frontend)
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# User ID for syncing (all devices with same ID will sync together)
# You can use any string - this identifies your data in the database
REACT_APP_USER_ID=my_unique_user_id

# Claude API Proxy Configuration (Optional)
# By default, the app uses http://localhost:3001/api/claude in development
# and /api/claude in production. Only set this if you need a custom URL.
# VITE_PROXY_URL=http://localhost:3001/api/claude
