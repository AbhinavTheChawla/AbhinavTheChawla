# Production Environment Variables for Vercel Deployment
# These values are automatically used when deploying to Vercel

# Supabase Configuration (set these in Vercel dashboard)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
# VITE_USER_ID=my_unique_user_id

# Claude API Proxy URL
# In production, this defaults to '/api/claude' (Vercel serverless function)
# Only set this if you need to override the default behavior
# VITE_PROXY_URL=/api/claude
